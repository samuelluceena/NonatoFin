# =============================================================================
# NonatoFin — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. NUNCA versione o .env real.
# Na Vercel: Project Settings -> Environment Variables.
# =============================================================================

# URL do projeto Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA do Supabase: "Publishable key" (sb_publishable_...) ou a
# "anon key" legada. É segura para uso com RLS. No NonatoFin ela fica somente
# no servidor (não vai para o navegador).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# SOMENTE LOCAL — usada apenas pelo script `npm run usuario:criar`.
# NUNCA configure esta chave na Vercel nem em qualquer hospedagem.
# Supabase -> Project Settings -> API Keys -> "Secret key" (ou service_role).
# -----------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=
